<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Custom Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/ivUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop"
                android:contentDescription="@string/user_avatar"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/cvAvatar"
            android:layout_toStartOf="@+id/cvRightIcon"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true"
            android:text="@string/hello_farmer"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvRightIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#FFFFF0">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/honey_orange"
                android:contentDescription="@string/notifications"/>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="24dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">
                    <!-- Placeholder for the Banner Image -->
                    <ImageView
                        android:id="@+id/ivBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_report_image"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/banner_image"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#22000000"/>
                    <TextView
                        android:id="@+id/tvBannerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="20dp"
                        android:text="@string/farmer_banner"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="16dp"/>

            <GridLayout
                android:id="@+id/gridActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- Action 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAction1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_action_alert">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivAction1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="@color/alert_red"/>
                        <TextView
                            android:id="@+id/tvAction1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spray_alert"
                            android:textAlignment="center"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="12dp"/>
                        <TextView
                            android:id="@+id/tvAction1Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/spraying_today_sub"
                            android:textAlignment="center"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAction2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_action_map">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivAction2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_dialog_map"
                            app:tint="@color/primary_green"/>
                        <TextView
                            android:id="@+id/tvAction2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/view_hive_map"
                            android:textAlignment="center"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="12dp"/>
                        <TextView
                            android:id="@+id/tvAction2Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nearby_hives_sub"
                            android:textAlignment="center"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAction3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_action_tips">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivAction3"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            app:tint="@color/honey_orange"/>
                        <TextView
                            android:id="@+id/tvAction3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bee_tips"
                            android:textAlignment="center"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="12dp"/>
                        <TextView
                            android:id="@+id/tvAction3Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/learn_protect"
                            android:textAlignment="center"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAction4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_action_history">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/ivAction4"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_popup_reminder"
                            app:tint="@color/honey_orange"/>
                        <TextView
                            android:id="@+id/tvAction4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notification_history"
                            android:textAlignment="center"
                            android:textColor="@color/text_dark"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="12dp"/>
                        <TextView
                            android:id="@+id/tvAction4Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textAlignment="center"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
