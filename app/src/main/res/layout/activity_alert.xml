<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_cream">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green"
        app:title="@string/spray_alert"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="@color/honey_yellow"
                android:layout_marginBottom="16dp"
                android:contentDescription="Alert Icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spraying_today"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send an alert to nearby beekeepers within 2 km radius."
                android:textAlignment="center"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_spray_date"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSprayDate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="16dp"
                android:hint="27 May 2024"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_spray_time"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSprayTime"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="16dp"
                android:hint="10:00 AM"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pesticide_optional"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etPesticide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="16dp"
                android:hint="e.g. Imidacloprid"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSendAlert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/send_alert"
                android:backgroundTint="@color/button_green"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
