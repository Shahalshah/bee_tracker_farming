<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Custom Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_green"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/user_avatar"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/cvAvatar"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true"
                android:text="@string/hello_beekeeper"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_notification_overlay"
                app:tint="@color/honey_orange"
                android:contentDescription="@string/notifications"/>
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp">
                        <!-- Placeholder for the Banner Image -->
                        <ImageView
                            android:id="@+id/ivBanner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_report_image"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/banner_image"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#44000000"/>
                        <TextView
                            android:id="@+id/tvBannerText"
                            android:layout_width="220dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="20dp"
                            android:text="@string/beekeeper_banner_text"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_actions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="16dp"/>

                <GridLayout
                    android:id="@+id/gridActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <!-- Action 1: Add Hive Location -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAction1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_action_map">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:orientation="vertical">
                            <ImageView
                                android:id="@+id/ivAction1"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@android:drawable/ic_dialog_map"
                                app:tint="@color/primary_green"/>
                            <TextView
                                android:id="@+id/tvAction1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_hive_location"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:id="@+id/tvAction1Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Action 2: Hive Health Tracker -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAction2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_action_tips">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:orientation="vertical">
                            <ImageView
                                android:id="@+id/ivAction2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@android:drawable/ic_menu_edit"
                                app:tint="@color/honey_orange"/>
                            <TextView
                                android:id="@+id/tvAction2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/health_tracker"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:id="@+id/tvAction2Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Action 3: Honey Production Records -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAction3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_action_honey">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:orientation="vertical">
                            <ImageView
                                android:id="@+id/ivAction3"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@android:drawable/ic_menu_save"
                                app:tint="#673AB7"/>
                            <TextView
                                android:id="@+id/tvAction3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/honey_production"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:id="@+id/tvAction3Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Action 4: Notification History -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAction4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/card_action_history">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="24dp"
                            android:orientation="vertical">
                            <ImageView
                                android:id="@+id/ivAction4"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@android:drawable/ic_popup_reminder"
                                app:tint="@color/primary_dark"/>
                            <TextView
                                android:id="@+id/tvAction4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/notification_history"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"/>
                            <TextView
                                android:id="@+id/tvAction4Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textColor="@color/text_dark"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </GridLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/primary_green"
            app:itemTextColor="@color/primary_green"
            app:labelVisibilityMode="labeled"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
